# TESTING & COVERAGE
# ==========================================

# PHPUnit
.phpunit.cache
.phpunit.result.cache

# Coverage reports
/coverage
/.nyc_output
/hot

# Pest PHP (if used in future)
/.pest

# ==========================================
# DEPLOYMENT & CI/CD
