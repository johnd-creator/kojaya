#!/usr/bin/env bash
set -euo pipefail

is_documentation_path() {
    [[ "$1" == "CHANGELOG.md" || "$1" == "README.md" || "$1" =~ ^docs/.+\.md$ ]]
}

if [[ "${1:-}" == "--paths" ]]; then
    shift
    if (($# == 0)); then
        printf 'false\n'
        exit 0
    fi
    for path in "$@"; do
        if ! is_documentation_path "$path"; then
            printf 'false\n'
            exit 0
        fi
    done
    printf 'true\n'
    exit 0
fi

base_sha="${BEFORE_SHA:-}"
head_sha="${CURRENT_SHA:-}"
if [[ "${EVENT_NAME:-}" == "pull_request" ]]; then
    base_sha="${PR_BASE_SHA:-}"
    head_sha="${PR_HEAD_SHA:-}"
fi
if [[ ! "$base_sha" =~ ^[0-9a-fA-F]{40}$ || ! "$head_sha" =~ ^[0-9a-fA-F]{40}$ ]]; then
    printf 'false\n'
    exit 0
fi
if ! changed_files="$(git diff --name-only -z "$base_sha" "$head_sha" | base64 -w0)"; then
    printf 'false\n'
    exit 0
fi
mapfile -d '' -t paths < <(printf '%s' "$changed_files" | base64 --decode)
bash "$0" --paths "${paths[@]}"
